# NebulaMind 环境变量示例
# 使用前复制为 .env 并填写真实值，切勿将 .env 提交到仓库

DATABASE_URL=jdbc:postgresql://localhost:5432/erDiagram
DB_USERNAME=root
DB_PASSWORD=change-me

REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=change-me

RABBITMQ_HOST=localhost
RABBITMQ_PORT=5672
RABBITMQ_USERNAME=guest
RABBITMQ_PASSWORD=change-me

MINIO_ENDPOINT=http://localhost:9000
MINIO_ACCESS_KEY=change-me
MINIO_SECRET_KEY=change-me
MINIO_BUCKET_NAME=nebulamind-files

MAAS_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
MAAS_BASE_URL=https://maas-api.ai-yuanjing.com/openapi/compatible-mode/v1

OPENAI_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
OPENAI_LLM_MODEL=deepseek-v3_2
LLM_PROVIDER=openai

AI_SERVICE_BASE_URL=http://localhost:8081
AI_SERVICE_API_KEY=change-me

JWT_SECRET=change-me
JWT_EXPIRE_HOURS=24
JWT_REFRESH_EXPIRE_HOURS=72

INTERNAL_API_KEY=change-me

NEBULAMIND_STORAGE_ENABLED=local
